{
  "name": "community-hero",
  "version": "0.1.0",
  "private": true,
  "description": "CIVICPULSE AI — hyperlocal civic issue reporting for Vibe to Ship (Vibe2Ship)",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:server": "npm run dev --prefix server",
    "build": "npm run build --prefix frontend",
    "preview": "npm run preview --prefix frontend",
    "test": "npm test --prefix server",
    "lint": "npm run lint --prefix frontend",
    "build:server": "npm run build --prefix server",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "screenshots:prod": "node scripts/capture-screenshots.mjs --base=https://community-hero-987477089222.asia-south1.run.app"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "playwright": "^1.52.0"
  }
}
