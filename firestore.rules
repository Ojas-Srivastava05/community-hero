rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function userSelfWritableKeys() {
      return ['displayName', 'leaderboardOptIn', 'email', 'photoURL', 'createdAt', 'updatedAt'];
    }

    function userGamificationUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny([
          'civicPoints',
          'badges',
          'weeklyPoints',
          'weeklyPointsWeek',
          'reportDates',
          'streakBonusDates',
          'wardReportCounts',
          'upvotesGiven',
        ]);
    }

    match /issues/{issueId} {
      // Guest / anonymous read — map, issue detail, share links
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.keys().hasAll(['title', 'category', 'status', 'createdAt']);
      allow update: if signedIn() && (
        resource.data.reporterId == request.auth.uid
        || isAdmin()
      );
      allow delete: if false;

      match /votes/{voteId} {
        allow read: if true;
        allow create: if signedIn() && voteId == request.auth.uid;
        allow update, delete: if false;
      }

      match /events/{eventId} {
        allow read: if true;
        allow write: if signedIn();
      }
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny([
          'civicPoints',
          'badges',
          'weeklyPoints',
          'weeklyPointsWeek',
          'reportDates',
          'streakBonusDates',
          'wardReportCounts',
          'upvotesGiven',
        ]);
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(userSelfWritableKeys())
        && userGamificationUnchanged();
      allow delete: if false;
    }

    match /departments/{deptId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /threads/{threadId} {
      allow read: if true;
      allow create: if signedIn();
      allow update: if signedIn();
      match /messages/{msgId} {
        allow read: if true;
        allow create: if signedIn();
      }
    }
  }
}
