# =============================================================================
# Community Hero (CIVICPULSE AI) — Environment Variables
# Appendix N (Master Plan) + implementation aliases used in this repo
# =============================================================================
# Copy to:
#   frontend/.env          — VITE_* variables (baked at build time)
#   server/.env            — server runtime variables
# Never commit real secrets. Cloud Run: set via deploy script or Console.
# =============================================================================

# -----------------------------------------------------------------------------
# Appendix N — GEMINI_API_KEY (Required for live AI)
# Auto-provisioned in Google AI Studio Secrets panel when using Build mode.
# Server-only. Never expose in browser network tab.
# -----------------------------------------------------------------------------
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Appendix N — MAPS_API_KEY (Required for Maps + Geocoding)
# Master Plan name. In this repo also aliased as GOOGLE_MAPS_API_KEY (server)
# and VITE_GOOGLE_MAPS_API_KEY (frontend build). Restrict key to:
#   - https://community-hero-*.run.app/*
#   - http://localhost:5173/*
# -----------------------------------------------------------------------------
MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# -----------------------------------------------------------------------------
# Appendix N — FIREBASE_PROJECT_ID (Required)
# GCP / Firebase project for Firestore, Auth, Storage.
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=community-hero-vibe2ship

# -----------------------------------------------------------------------------
# Appendix N — FIREBASE_SERVICE_ACCOUNT (Production)
# JSON service account for Admin SDK writes. In this repo use
# FIREBASE_SERVICE_ACCOUNT_JSON (single-line JSON string) or Application
# Default Credentials on Cloud Run (no env needed).
# -----------------------------------------------------------------------------
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# -----------------------------------------------------------------------------
# Appendix N — STORAGE_BUCKET (Required)
# Cloud Storage bucket for report images and proof photos.
# Master Plan name. Implementation: FIREBASE_STORAGE_BUCKET.
# -----------------------------------------------------------------------------
STORAGE_BUCKET=community-hero-vibe2ship-uploads
FIREBASE_STORAGE_BUCKET=community-hero-vibe2ship-uploads

# -----------------------------------------------------------------------------
# Appendix N — RATE_LIMIT_ENABLED (Optional, default true)
# Set false for local dev load testing. Production: always true.
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true

# -----------------------------------------------------------------------------
# Appendix N — REDIS_URL (Optional)
# Shared cache for rate limits (L3) and analytics aggregates. Omit for MVP.
# Example: redis://localhost:6379
# -----------------------------------------------------------------------------
# REDIS_URL=

# -----------------------------------------------------------------------------
# Appendix N — ADMIN_UIDS (Optional)
# Comma-separated Firebase Auth UIDs with admin panel access.
# Alternative: ADMIN_EMAILS (used by this repo's auth middleware).
# -----------------------------------------------------------------------------
ADMIN_UIDS=
ADMIN_EMAILS=srivastavaojas454@gmail.com

# -----------------------------------------------------------------------------
# Appendix N — DEMO_WARD_ID (Optional)
# Ward ID for seeded demo issues (Appendix R). Default: DEMO_WARD_001
# -----------------------------------------------------------------------------
DEMO_WARD_ID=DEMO_WARD_001

# -----------------------------------------------------------------------------
# Appendix N — GEMINI_MODEL_VISION (Optional)
# Default: gemini-2.5-flash — structured JSON vision classify (Appendix B)
# Do NOT use gemini-2.5-flash-image for JSON mode.
# -----------------------------------------------------------------------------
GEMINI_MODEL_VISION=gemini-2.5-flash

# -----------------------------------------------------------------------------
# Appendix N — GEMINI_MODEL_LITE (Optional)
# Default: gemini-2.5-flash-lite — chat, summaries, status narratives
# -----------------------------------------------------------------------------
GEMINI_MODEL_LITE=gemini-2.5-flash-lite

# =============================================================================
# Frontend (Vite) — copy VITE_* block to frontend/.env
# Required for Firebase Auth + optional Maps tiles in browser
# =============================================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=community-hero-vibe2ship.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=community-hero-vibe2ship
VITE_FIREBASE_STORAGE_BUCKET=community-hero-vibe2ship.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=987477089222
VITE_FIREBASE_APP_ID=1:987477089222:web:cbfb3d8721c5bf8861f0c7

# Optional: override API base (default: same-origin /api via Vite proxy in dev)
# VITE_API_URL=http://localhost:3001

# =============================================================================
# Server runtime (local dev — copy to server/.env)
# =============================================================================
PORT=3001
NODE_ENV=development

# =============================================================================
# Deploy / CI (scripts/deploy-cloud-run.sh)
# =============================================================================
GCP_PROJECT_ID=community-hero-vibe2ship
# GCP_REGION=asia-south1
